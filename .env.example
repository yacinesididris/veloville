# Copier ce fichier en .env et renseigner les valeurs.

# Connexion PostgreSQL (format SQLAlchemy + psycopg 3)
DATABASE_URL= "postgresql+psycopg://Utilisateur:MotDePasse@localhost:5432/veloville"
TEST_DATABASE_URL = "postgresql+psycopg://Utilisateur:MotDePasse@localhost:5432/veloville_bdd_test"

# Jeton JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Front Streamlit : adresse de l'API
API_URL=http://localhost:8000
API_TIMEOUT_SECONDES=5
