# Copier ce fichier en .env puis renseigner les valeurs.

# Connexions PostgreSQL (mot de passe sans caractère réservé dans l'URL)
DATABASE_URL=postgresql+psycopg://veloville:mot_de_passe@localhost:5432/veloville
TEST_DATABASE_URL=postgresql+psycopg://veloville:mot_de_passe@localhost:5432/veloville_bdd_test

# Jeton JWT
JWT_SECRET=a_remplacer_par_une_cle_aleatoire
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Front Streamlit : adresse de l'API
API_URL=http://localhost:8000
API_TIMEOUT_SECONDES=5
